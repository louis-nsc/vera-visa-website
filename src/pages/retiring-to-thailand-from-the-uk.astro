---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'retiring-to-thailand-from-the-uk');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/retiring-to-thailand-from-the-uk/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Thailand Visa for UK Citizens: All Options', href: '/thailand-visa-for-uk-citizens/' },
    { label: 'Retirement Visa for UK Citizens', href: '/retirement-visa-uk-citizens/'   },
    { label: 'Retirement Visa Chiang Mai',      href: '/retirement-visa-chiang-mai/'    },
    { label: 'Retirement Visa Thailand Cost',   href: '/retirement-visa-thailand-cost/' },
  ]}
>
  <Content />
</BlogLayout>
