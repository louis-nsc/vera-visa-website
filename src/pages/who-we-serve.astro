---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCtaBand from '../components/sections/FinalCtaBand.astro';

const segments = [
  { name: 'Digital nomads & remote workers', body: 'Working remotely for a foreign employer or clients? The DTV visa gives you five years of legal stay in Chiang Mai without needing a Thai work permit.', href: '/dtv-visa-chiang-mai/', cta: 'DTV Visa →' },
  { name: 'Students on ED visas', body: 'Studying Thai language, training in Muay Thai, or enrolled at a Chiang Mai university — the Education Visa keeps you legal for the duration of your course.', href: '/education-visa-chiang-mai/', cta: 'Education Visa →' },
  { name: 'Retirees over 50', body: 'The Non-Immigrant O-A retirement visa gives you year-round legal residence in Chiang Mai, renewed annually by our team.', href: '/retirement-visa-chiang-mai/', cta: 'Retirement Visa →' },
  { name: 'Spouses of Thai nationals', body: 'Married to a Thai national? The Non-Immigrant O marriage visa gives you annual-extension residency in Chiang Mai, renewed by our team each year.', href: '/marriage-visa-chiang-mai/', cta: 'Marriage Visa →' },
  { name: 'Parents & guardians', body: 'Supporting a child enrolled in a Chiang Mai school? The Non-Immigrant O guardian visa keeps you legally resident for as long as the child is enrolled.', href: '/guardian-visa-chiang-mai/', cta: 'Guardian Visa →' },
  { name: 'Business owners & professionals', body: 'Working for or running a Thai company requires a Non-Immigrant B visa and work permit. We handle both, plus the compliance that keeps them valid.', href: '/work-permits-business-visas-chiang-mai/', cta: 'Business Visa & Work Permits →' },
  { name: 'Volunteers & NGO workers', body: 'Volunteering long-term with a registered Thai non-profit? The Non-Immigrant O volunteer visa is the correct legal pathway for unpaid work.', href: '/volunteer-visa-chiang-mai/', cta: 'Volunteer Visa →' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Vera Visa Agency',
    url: 'https://vera-visa.com',
    description: 'Vera Visa Agency serves expats, students, retirees, remote workers, families, and business professionals navigating Thai immigration requirements in Chiang Mai.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
      { '@type': 'ListItem', position: 2, name: 'Who We Serve', item: 'https://vera-visa.com/who-we-serve/' },
    ],
  },
];
---

<BaseLayout
  title="Who We Serve — Vera Visa Agency Chiang Mai"
  description="Vera Visa Agency helps digital nomads, students, retirees, families, business professionals, and volunteers get legal visa status in Chiang Mai."
  canonicalUrl="https://vera-visa.com/who-we-serve/"
  ogTitle="Who We Serve — Vera Visa Agency Chiang Mai"
  ogDescription="Expats, students, retirees, remote workers, families, and business professionals — see which visa category fits your situation in Chiang Mai."
  schema={schema}
>

  <section class="header">
    <div class="container">
      <p class="eyebrow">Who we serve</p>
      <h1 class="h1">Built for people mid-move.</h1>
      <p class="intro">Every visa category exists for a reason. Find your situation below, and we'll tell you exactly which one applies.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="segments-grid">
        {segments.map((s) => (
          <a href={s.href} class="segment-card">
            <span class="segment-dot" aria-hidden="true"></span>
            <h2 class="segment-name">{s.name}</h2>
            <p class="segment-body">{s.body}</p>
            <span class="segment-cta">{s.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCtaBand
    heading="Not sure which category fits you?"
    subtext="A free consultation confirms the right visa for your situation — usually in one WhatsApp chat."
  />

</BaseLayout>

<style>
  .header { background: var(--sand); padding: var(--space-7) 0 var(--space-8); }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2.25rem, 4.5vw, var(--text-display-l));
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .intro {
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
    max-width: 56ch;
  }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .segment-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  .segment-card:hover { border-color: var(--ink); }

  .segment-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pill);
    background: var(--approved);
    margin-bottom: var(--space-4);
  }

  .segment-name {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-s);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }

  .segment-body {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
    flex: 1;
  }

  .segment-cta {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    color: var(--signal-deeper);
  }

  @media (max-width: 760px) {
    .segments-grid { grid-template-columns: 1fr; }
  }
</style>
