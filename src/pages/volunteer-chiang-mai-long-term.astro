---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'volunteer-chiang-mai-long-term');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  heroImage="/images/banners/volunteer"
  heroAlt="Tote of seedlings and a clipboard at a community garden, long-term volunteering in Thailand"
  {title} {description}
  canonicalUrl="https://vera-visa.com/volunteer-chiang-mai-long-term/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Volunteer Visa Thailand', href: '/category/volunteer-visa/' },
    { label: 'Volunteer Visa Chiang Mai: Full Guide', href: '/volunteer-visa-chiang-mai/'       },
    { label: 'Can You Volunteer on a Tourist Visa?',   href: '/volunteer-thailand-tourist-visa/' },
    { label: 'Education Visa Chiang Mai',              href: '/education-visa-chiang-mai/'       },
  ]}
>
  <Content />
</BlogLayout>
