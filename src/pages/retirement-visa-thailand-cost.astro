---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'retirement-visa-thailand-cost');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/retirement-visa-thailand-cost/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Chiang Mai: Full Guide',  href: '/retirement-visa-chiang-mai/'    },
    { label: 'Retirement Visa for Americans',            href: '/retirement-visa-americans/'     },
    { label: 'Retirement Visa for Australians',          href: '/retirement-visa-australians/'   },
    { label: 'More Retirement Visa Guides',              href: '/category/retirement-visa/'      },
  ]}
>
  <Content />
</BlogLayout>
