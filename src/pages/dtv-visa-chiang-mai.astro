---
import ServicePageLayout from '../layouts/ServicePageLayout.astro';
import QuickFactsStrip from '../components/sections/QuickFactsStrip.astro';
import BenefitGrid from '../components/sections/BenefitGrid.astro';
import ExpertInsightCallout from '../components/sections/ExpertInsightCallout.astro';
import CtaCallout from '../components/sections/CtaCallout.astro';
import ProcessComparisonCards from '../components/sections/ProcessComparisonCards.astro';
import RelatedGuides from '../components/sections/RelatedGuides.astro';
import FinalCtaBand from '../components/sections/FinalCtaBand.astro';
import RequirementNote from '../components/sections/RequirementNote.astro';
import BenefitsSplit from '../components/sections/BenefitsSplit.astro';
import AccordionSection from '../components/interactive/AccordionSection';

/*
 * CONTENT HOLD (visa-specialist sign-off pending)
 * ------------------------------------------------
 * This page deliberately makes NO statements about: 90-day reporting (TM47),
 * TM30, health insurance, what a DTV holder may do as remote work, or Thai
 * employment / work permits. Those were removed on the Nov 2026 rewrite and
 * must only return after the visa specialist approves exact wording for each
 * one. Do not paste a single rule across every nationality page. See
 * PLAN.md, "Held back: DTV statements awaiting specialist approval".
 */

const FAQS = [
  {
    q: 'Which countries can apply for the DTV?',
    a: 'The DTV is open to most nationalities that can apply at a Thai embassy or through the official e-visa portal. A small number of nationalities face additional checks. We confirm eligibility for your passport in your first consultation.',
  },
  {
    q: 'Can I apply for the DTV from inside Thailand?',
    a: 'The DTV is designed to be applied for from outside Thailand. In-country conversion is not a standard route. If you are already in Thailand on another visa, we advise on the best path for your situation.',
  },
  {
    q: 'Can I leave Thailand on the DTV?',
    a: 'Yes. The DTV is multiple-entry, so you can travel in and out of Thailand within the five-year term. Each entry gives a stay of up to 180 days.',
  },
  {
    q: 'How long does the application take?',
    a: 'Processing typically takes 2 to 6 weeks. The route (embassy or e-visa portal) and your nationality affect the timeline, and we tell you which route fits before you start.',
  },
  {
    q: 'How much does the DTV cost?',
    a: 'The official government fee is 10,000 THB per application. Our service fee is separate, and we give you the full breakdown on WhatsApp.',
  },
  {
    q: 'Can I get a Thai bank account on a DTV?',
    a: 'Often yes, though it varies by bank branch and the documents you can present. We can advise on the right branch and the documents to bring.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Destination Thailand Visa (DTV) assistance in Chiang Mai',
  serviceType: 'Visa application assistance',
  url: 'https://vera-visa.com/dtv-visa-chiang-mai/',
  description: 'Destination Thailand Visa (DTV) assistance from a Chiang Mai visa agency: eligibility screening, document review, application support and cost guidance.',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Vera Visa Agency',
    url: 'https://vera-visa.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Icon Park Hotel, 2F, Room 215, 310 Manee Nopparat Rd',
      addressLocality: 'Mueang Chiang Mai District',
      addressRegion: 'Chiang Mai',
      postalCode: '50200',
      addressCountry: 'TH',
    },
  },
  areaServed: [
    { '@type': 'City', name: 'Chiang Mai' },
    { '@type': 'Country', name: 'Thailand' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: 'DTV Visa Chiang Mai', item: 'https://vera-visa.com/dtv-visa-chiang-mai/' },
  ],
};
---

<ServicePageLayout
  ogImage="/og/dtv-visa-chiang-mai.jpg"
  bannerImage="/images/banners/dtv.webp"
  bannerAlt="DTV visa in Chiang Mai: remote worker's laptop and iced coffee at a café table by a garden window"
  title="DTV Visa Assistance in Chiang Mai | Vera Visa"
  description="Local Destination Thailand Visa help in Chiang Mai: eligibility screening, document review, application support and cost guidance. Free WhatsApp consultation."
  canonicalUrl="https://vera-visa.com/dtv-visa-chiang-mai/"
  ogTitle="Destination Thailand Visa Assistance in Chiang Mai | Vera Visa"
  ogDescription="Eligibility screening, document review, application support and cost guidance for the five-year Destination Thailand Visa, from a local Chiang Mai team."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
  eyebrow="DTV · Chiang Mai Visa Assistance"
  intro="Vera Visa is a visa agency in Chiang Mai. We screen your eligibility, review your documents, handle the Destination Thailand Visa application, and walk you through the costs."
  ctaText="Book a free consultation on WhatsApp →"
  statusRows={[
    { label: 'Visa Type',   value: 'DTV'        },
    { label: 'Location',    value: 'Chiang Mai'  },
    { label: 'Stay / Entry',value: '180 days'   },
  ]}
  statusState="approved"
  statusLabel="Approved"
>
  <Fragment slot="headline">
    Destination Thailand Visa assistance in <span style="color: var(--signal);">Chiang Mai</span>
  </Fragment>

  <QuickFactsStrip facts={[
    { label: 'Visa Duration',  value: '5 years'           },
    { label: 'Visa Type',      value: 'Multiple entry'     },
    { label: 'Stay / Entry',   value: '180 days'          },
    { label: 'Extendable',     value: 'Yes · +180 days'   },
    { label: 'Obtain At',      value: 'Embassy / E-Visa'  },
    { label: 'Minimum Age',    value: 'Age 20+'           },
    { label: 'Family',         value: 'Spouse & children' },
  ]} />

  <!-- How we help -->
  <BenefitGrid
    eyebrow="What we do"
    heading="How we help with your DTV application"
    intro="One local team, from your first question to the submitted application."
    items={[
      { title: 'Eligibility screening',  body: 'We work out which DTV track fits you and whether your nationality brings extra checks, before you gather anything.' },
      { title: 'Document review',        body: 'We assemble, translate and check every file for formatting and name consistency before it reaches the embassy or portal.' },
      { title: 'Application support',    body: 'We choose the right route for your timeline, prepare the application and submit it on your behalf.' },
      { title: 'Cost guidance',          body: 'You see the official government fee and our service fee laid out separately, so there are no surprises.' },
      { title: 'Local team in Chiang Mai', body: 'Co-founders Pupae, Tofu and Big and their team are based at Icon Park Hotel, Chiang Mai, and answer on WhatsApp.' },
      { title: 'Free consultation first', body: 'A WhatsApp chat tells you whether the DTV is the right visa for your situation, usually in one conversation.' },
    ]}
  />

  <div style="background: var(--paper); padding: var(--space-7) 0 var(--space-9);">
    <div class="container">

      <!-- ELIGIBILITY SCREENING -->
      <section id="eligibility-screening" class="dtv-block">
        <h2 class="panel-h2">Eligibility screening</h2>
        <p class="panel-intro">The DTV has two eligibility tracks: remote work for a foreign employer or clients, and approved "soft power" activities such as Muay Thai training, Thai cooking courses and wellness programs. In your first chat we work out which track fits you and what you would need to show.</p>
        <ul class="dtv-list">
          <li>Which track fits your situation, and what evidence it needs</li>
          <li>Whether your passport brings additional checks (a small number of nationalities do)</li>
          <li>Where you can apply from. The DTV is designed to be applied for from outside Thailand, and if you are already here on another visa we advise on the best path</li>
          <li>Whether the name on your contracts, bank account and application line up. Most rejections we see come from mismatched evidence</li>
        </ul>
      </section>

      <!-- DOCUMENT REVIEW -->
      <section id="document-review" class="dtv-block">
        <h2 class="panel-h2">Document review</h2>
        <p class="panel-intro">We assemble, translate and check every document before submission. Typical documents, grouped by category:</p>

        <AccordionSection client:visible title="Identity & travel documents" defaultOpen={true}>
          <ul>
            <li>Passport valid for at least 6 months, with blank visa pages</li>
            <li>Recent passport-style photograph (white background, taken within 6 months)</li>
            <li>Completed DTV application form</li>
            <li>Proof of current residential address</li>
          </ul>
        </AccordionSection>

        <AccordionSection client:visible title="Financial evidence">
          <ul>
            <li>Bank statements covering the required period (typically 6 months)</li>
            <li>Proof of income: employment contract, client invoices, or a freelance portfolio</li>
          </ul>
          <RequirementNote
            label="Minimum Account Balance"
            desc="This figure moves with current DTV requirements, so we don't print a number that could be outdated by the time you apply. We confirm the exact threshold with you before you start gathering bank statements, not after."
          />
        </AccordionSection>

        <AccordionSection client:visible title="Purpose-of-stay documents">
          <ul>
            <li>Employment contract with a foreign company, or client contracts and invoices for freelancers</li>
            <li>Company registration documents if self-employed</li>
            <li>Or enrolment confirmation for an approved soft-power activity (Muay Thai, cooking course, etc.)</li>
          </ul>
        </AccordionSection>

        <AccordionSection client:visible title="Family dependents">
          <ul>
            <li>Marriage certificate for a spouse (may require legalisation or apostille)</li>
            <li>Birth certificates for children under 20</li>
            <li>Evidence that the primary applicant's income covers the full family</li>
          </ul>
        </AccordionSection>

        <ExpertInsightCallout body="Document preparation is where most delays happen. We check every file for formatting, naming consistency and translation before anything reaches the embassy, so your application goes in right the first time." />
      </section>

    </div>
  </div>

  <!-- APPLICATION SUPPORT -->
  <ProcessComparisonCards
    heading="Application support: two routes, we handle either"
    intro="We prepare and submit your application through the embassy or the official e-visa portal, whichever suits your timeline and nationality."
    routeA={{
      label: 'Route A',
      title: 'In-Person Embassy',
      steps: [
        'Book an appointment at a Thai embassy in your country',
        'Submit your documents and pay the 10,000 THB government fee',
        'Attend the appointment (typically 30–60 minutes)',
        'Collect the visa stamp once approved',
      ],
    }}
    routeB={{
      label: 'Route B',
      title: 'Official Online E-Visa Portal',
      steps: [
        'Create an account on the Thai government e-visa portal',
        'Upload your documents and pay the fee online',
        'Receive your e-visa confirmation by email',
        'Present the e-visa QR code at the airport on arrival',
      ],
    }}
    stats={[
      { label: 'Processing Time', value: '2–6 weeks', note: 'typical' },
      { label: 'Government Fee',  value: '10,000 THB' },
    ]}
  />

  <div style="background: var(--paper); padding: var(--space-7) 0 var(--space-9);">
    <div class="container">

      <!-- COST GUIDANCE -->
      <section id="cost-guidance" class="dtv-block">
        <h2 class="panel-h2">Cost guidance</h2>
        <p class="panel-intro">We separate what you pay the government from what you pay us, and walk you through both on WhatsApp.</p>
        <BenefitsSplit
          items={[
            'Government fee: 10,000 THB per application, covering the five-year visa',
            'Our service fee: separate from the government fee, quoted for your situation',
            'Minimum funds: we confirm the current threshold for your passport before you gather statements',
            'Extension: each 180-day stay can be extended once by a further 180 days at local immigration',
          ]}
          statLabel="Government Fee"
          statValue="10,000 THB"
          statDesc="Official fee per application. Chat with us on WhatsApp for a full breakdown including our service fee."
        />
        <p class="panel-intro" style="margin-top: var(--space-6);">
          Want the numbers in more detail? Read our <a href="/dtv-visa-thailand-cost/" class="vv-link">DTV visa cost guide</a>.
        </p>
      </section>

      <!-- CONSULTATION -->
      <section id="consultation" class="dtv-block">
        <h2 class="panel-h2">Start with a free consultation</h2>
        <p class="panel-intro">Tell us your nationality, where you plan to apply from and how you earn or what you plan to do in Thailand. We tell you whether the DTV fits, what you would need and what it would cost.</p>
        <CtaCallout
          kicker="Ready to get started?"
          body="A free WhatsApp consultation confirms whether the DTV is right for your situation, usually resolved in one chat."
          linkText="Chat with us now"
          linkHref="https://wa.me/66919192823"
        />
      </section>

      <!-- FAQ -->
      <section id="faq" class="dtv-block">
        <h2 class="panel-h2">DTV questions we get in Chiang Mai</h2>
        {FAQS.map((f, i) => (
          <AccordionSection client:visible title={f.q} defaultOpen={i === 0}>
            <p>{f.a}</p>
          </AccordionSection>
        ))}
        <p class="panel-intro" style="margin-top: var(--space-4); font-size: 0.9375rem;">Reviewed September 2026 against current Thai Immigration Bureau guidance and official embassy checklists. Visa rules can change: confirm specifics with our team before applying.</p>
      </section>

      <!-- OFFICE -->
      <section id="office" class="dtv-block">
        <h2 class="panel-h2">Our Chiang Mai office</h2>
        <p class="panel-intro">
          Vera Visa Agency, Icon Park Hotel, 2F, Room 215, 310 Manee Nopparat Rd, Mueang Chiang Mai District, Chiang Mai 50200.
        </p>
      </section>

    </div>
  </div>

  <!-- Related guides -->
  <RelatedGuides guides={[
    { label: 'DTV Visa Thailand', href: '/category/dtv-visa/' },
    { label: 'DTV Visa Thailand Cost',           href: '/dtv-visa-thailand-cost/' },
    { label: 'DTV Visa for Americans',           href: '/dtv-visa-americans/' },
    { label: 'Retirement Visa (O-A)',           href: '/retirement-visa-chiang-mai/' },
    { label: 'Education Visa (ED)',              href: '/education-visa-chiang-mai/' },
    { label: 'Business Visa & Work Permits (B)', href: '/work-permits-business-visas-chiang-mai/' },
  ]} />

  <FinalCtaBand
    heading="Not sure if the DTV is right for you?"
    subtext="A free consultation confirms the right visa for your situation, usually in one WhatsApp chat."
  />

  <style>
    .panel-h2 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--text-display-m);
      line-height: var(--lh-snug);
      letter-spacing: var(--ls-display);
      color: var(--ink);
      margin: 0 0 var(--space-2);
    }

    .panel-intro {
      font-family: var(--font-body);
      font-size: 1.0625rem;
      line-height: var(--lh-body);
      color: var(--text-body);
      margin: 0 0 var(--space-6);
      max-width: 64ch;
    }

    .dtv-block + .dtv-block {
      margin-top: var(--space-9);
    }

    .dtv-list {
      margin: 0;
      padding-left: var(--space-5);
      font-family: var(--font-body);
      font-size: 1.0625rem;
      line-height: 1.8;
      color: var(--text-body);
      max-width: 64ch;
    }
  </style>

</ServicePageLayout>
