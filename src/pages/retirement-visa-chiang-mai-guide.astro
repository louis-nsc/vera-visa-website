---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'retirement-visa-chiang-mai-guide');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/retirement-visa-chiang-mai-guide/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Chiang Mai: Service Page', href: '/retirement-visa-chiang-mai/'     },
    { label: 'Retirement Visa Thailand Cost',             href: '/retirement-visa-thailand-cost/'  },
    { label: 'Retirement Visa Thailand Requirements',     href: '/retirement-visa-thailand-requirements/' },
  ]}
>
  <Content />
</BlogLayout>
