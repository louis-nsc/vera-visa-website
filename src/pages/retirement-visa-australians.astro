---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'retirement-visa-australians');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/retirement-visa-australians/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Thailand', href: '/category/retirement-visa/' },
    { label: 'Thailand Visa for Australians: All Options', href: '/thailand-visa-for-australians/' },
    { label: 'Retirement Visa Chiang Mai: Full Guide',  href: '/retirement-visa-chiang-mai/'  },
    { label: 'Retirement Visa for Americans',            href: '/retirement-visa-americans/'   },
    { label: 'Retirement Visa for UK Citizens',          href: '/retirement-visa-uk-citizens/' },
    { label: 'Retirement Visa Thailand Cost',            href: '/retirement-visa-thailand-cost/' },
  ]}
>
  <Content />
</BlogLayout>
