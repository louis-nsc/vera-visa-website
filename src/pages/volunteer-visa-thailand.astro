---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'volunteer-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/volunteer-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Volunteer Visa Chiang Mai — Full Guide',  href: '/volunteer-visa-chiang-mai/'  },
    { label: 'Education Visa (ED) Chiang Mai',          href: '/ed-visa-chiang-mai/'         },
    { label: 'DTV Visa Chiang Mai',                     href: '/dtv-visa-chiang-mai/'        },
    { label: 'Category: Volunteer Visa',                href: '/category/volunteer-visa/'    },
  ]}
>
  <Content />
</BlogLayout>
