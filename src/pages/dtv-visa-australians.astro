---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'dtv-visa-australians');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/dtv-visa-australians/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'DTV Visa Thailand', href: '/category/dtv-visa/' },
    { label: 'Thailand Visa for Australians: All Options', href: '/thailand-visa-for-australians/' },
    { label: 'DTV Visa Chiang Mai: Full Guide', href: '/dtv-visa-chiang-mai/'    },
    { label: 'DTV Visa for Americans',           href: '/dtv-visa-americans/'     },
    { label: 'DTV Visa Thailand Cost',           href: '/dtv-visa-thailand-cost/' },
  ]}
>
  <Content />
</BlogLayout>
