---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thailand-work-permit-guide');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/thailand-work-permit-guide/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Business Visa & Work Permits — Full Guide', href: '/work-permits-business-visas-chiang-mai/' },
    { label: 'Work Permit Requirements Checklist',        href: '/thailand-work-permit-requirements/'      },
    { label: 'DTV Visa Chiang Mai',                       href: '/dtv-visa-chiang-mai/'                    },
  ]}
>
  <Content />
</BlogLayout>
