---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'guardian-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/guardian-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Guardian Visa Chiang Mai — Full Guide', href: '/guardian-visa-chiang-mai/'             },
    { label: 'Guardian Visa Thailand Requirements',   href: '/guardian-visa-thailand-requirements/'  },
    { label: 'Guardian vs Dependent Visa',            href: '/guardian-visa-vs-dependent-visa-thailand/' },
  ]}
>
  <Content />
</BlogLayout>
