---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thailand-work-permit-requirements');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/thailand-work-permit-requirements/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Work Permits Thailand', href: '/category/work-permits/' },
    { label: 'Business Visa & Work Permits: Full Guide', href: '/work-permits-business-visas-chiang-mai/' },
    { label: 'DTV Visa Chiang Mai',                        href: '/dtv-visa-chiang-mai/'                    },
    { label: 'Visa Agent Chiang Mai',                      href: '/visa-agent-chiang-mai/'                  },
  ]}
>
  <Content />
</BlogLayout>
