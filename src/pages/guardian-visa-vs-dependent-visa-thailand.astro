---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'guardian-visa-vs-dependent-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  heroImage="/images/guides/guide-two-paths"
  heroAlt="A garden path splitting in two, guardian visa versus dependent visa in Thailand"
  {title} {description}
  canonicalUrl="https://vera-visa.com/guardian-visa-vs-dependent-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Guardian Visa Thailand', href: '/category/guardian-visa/' },
    { label: 'Guardian Visa Chiang Mai: Full Guide',  href: '/guardian-visa-chiang-mai/'  },
    { label: 'Guardian Visa Thailand Requirements',    href: '/guardian-visa-thailand-requirements/' },
    { label: 'Marriage Visa Chiang Mai',               href: '/marriage-visa-chiang-mai/'  },
  ]}
>
  <Content />
</BlogLayout>
