---
import BaseLayout from '../layouts/BaseLayout.astro';

const LAST_UPDATED = 'July 2026';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: 'https://vera-visa.com/terms-of-service/' },
  ],
};
---

<BaseLayout
  title="Terms of Service | Vera Visa"
  description="The terms that apply to using vera-visa.com and engaging Vera Visa Agency for visa consulting services in Chiang Mai, Thailand."
  canonicalUrl="https://vera-visa.com/terms-of-service/"
  schema={schema}
>
  <nav class="legal-breadcrumb container" aria-label="Breadcrumb">
    <a href="/" class="bc-link">Home</a>
    <span class="bc-sep" aria-hidden="true">›</span>
    <span class="bc-current">Terms of Service</span>
  </nav>

  <header class="legal-header">
    <div class="container legal-header__inner">
      <p class="legal-eyebrow">Vera Visa Agency</p>
      <h1 class="legal-h1">Terms of Service</h1>
      <p class="legal-updated">Last updated: {LAST_UPDATED}</p>
    </div>
  </header>

  <div class="legal-body container">
    <div class="legal-prose">
      <p>
        These terms apply to your use of vera-visa.com (the "Site") and to any visa
        consulting services you engage Vera Visa Agency ("Vera Visa", "we", "us") to
        provide. By using the Site or engaging our services, you agree to these terms.
      </p>

      <h2>Who we are</h2>
      <p>
        Vera Visa Agency is a visa consulting agency based in Chiang Mai, Thailand. We
        are <strong>not a law firm</strong>, and nothing on this Site constitutes legal
        advice. For complex immigration matters — deportation risk, criminal history,
        or disputes with immigration authorities — we recommend engaging a licensed
        Thai attorney in addition to, or instead of, our services.
      </p>

      <h2>Information on this Site</h2>
      <p>
        We work to keep visa requirements, fees, and timelines on this Site accurate
        and current, and we cross-check figures against official sources where
        possible. Thai immigration rules do change, sometimes with little notice.
        Information here is a starting point, not a substitute for confirming your
        specific situation with our team before you act on it — see the note at the
        bottom of every page.
      </p>

      <h2>No guarantee of approval</h2>
      <p>
        Visa and work permit decisions are made solely by Thai Immigration Bureau and
        other relevant Thai government authorities — not by us. We prepare and review
        applications carefully, but engaging our services is not a guarantee that any
        application will be approved, or approved within a particular timeframe.
      </p>

      <h2>Using this Site</h2>
      <p>
        You agree not to misuse the Site — including attempting to interfere with its
        normal operation, submitting false information through the contact form, or
        using any content here for automated bulk collection without our permission.
      </p>

      <h2>External links</h2>
      <p>
        This Site links to external resources, including official Thai government
        sites and insurers we work with. We don't control those sites and aren't
        responsible for their content or availability.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        To the extent permitted by Thai law, Vera Visa Agency is not liable for
        indirect, incidental, or consequential losses arising from your use of this
        Site or reliance on information published on it. This doesn't limit our
        liability for matters that can't be excluded under Thai law, or affect the
        separate terms of any service engagement you enter into with us directly.
      </p>

      <h2>Service engagements</h2>
      <p>
        These Site-wide terms cover use of the website itself. If you engage Vera Visa
        Agency for visa consulting services, the specific scope, fees, and terms of
        that engagement are confirmed directly with our team — typically over WhatsApp
        or in person — before any work begins.
      </p>

      <h2>Governing law</h2>
      <p>
        These terms are governed by the laws of Thailand. Any dispute arising from
        these terms or your use of the Site will be subject to the jurisdiction of the
        Thai courts.
      </p>

      <h2>Changes to these terms</h2>
      <p>
        We may update these terms from time to time. The "last updated" date at the
        top of this page reflects the most recent revision. Continued use of the Site
        after a change means you accept the updated terms.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these terms: <a href="mailto:pupae@vera-visa.com">pupae@vera-visa.com</a>,
        or visit us at 2F, Room 215 Icon Park Hotel, 310 Manee Nopparat Rd, Mueang
        Chiang Mai District, Chiang Mai 50200.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .bc-link { color: var(--ink-45); text-decoration: none; transition: color var(--dur-fast) ease; }
  .bc-link:hover { color: var(--signal-deeper); }
  .bc-sep { color: var(--line); }
  .bc-current { color: var(--ink-45); }

  .legal-header {
    background: var(--sand);
    padding: var(--space-7) 0 var(--space-8);
  }

  .legal-header__inner { max-width: 760px; }

  .legal-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin: 0 0 var(--space-4);
  }

  .legal-h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2rem, 4vw, var(--text-display-l));
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .legal-updated {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
    margin: 0;
  }

  .legal-body {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .legal-prose { max-width: 720px; }

  .legal-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-s);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: var(--space-7) 0 var(--space-3);
  }

  .legal-prose :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
  }

  .legal-prose :global(strong) { color: var(--ink); font-weight: var(--fw-semibold); }
  .legal-prose :global(a) { color: var(--signal-deeper); text-decoration: underline; text-underline-offset: 2px; }
</style>
