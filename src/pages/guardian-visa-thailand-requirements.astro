---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'guardian-visa-thailand-requirements');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/guardian-visa-thailand-requirements/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Guardian Visa Chiang Mai: Full Guide', href: '/guardian-visa-chiang-mai/' },
    { label: 'Marriage Visa Chiang Mai',              href: '/marriage-visa-chiang-mai/' },
    { label: 'More Guardian Visa Guides',             href: '/category/guardian-visa/' },
  ]}
>
  <Content />
</BlogLayout>
