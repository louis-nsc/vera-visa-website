---
import ServicePageLayout from '../layouts/ServicePageLayout.astro';
import QuickFactsStrip from '../components/sections/QuickFactsStrip.astro';
import BenefitGrid from '../components/sections/BenefitGrid.astro';
import ExpertInsightCallout from '../components/sections/ExpertInsightCallout.astro';
import CtaCallout from '../components/sections/CtaCallout.astro';
import ProcessComparisonCards from '../components/sections/ProcessComparisonCards.astro';
import RelatedGuides from '../components/sections/RelatedGuides.astro';
import FinalCtaBand from '../components/sections/FinalCtaBand.astro';
import FinancialRoutes from '../components/sections/FinancialRoutes.astro';
import BenefitsSplit from '../components/sections/BenefitsSplit.astro';
import TabBar from '../components/interactive/TabBar';
import AccordionSection from '../components/interactive/AccordionSection';

const TABS = [
  { id: 'eligibility',  label: 'Eligibility'  },
  { id: 'requirements', label: 'Requirements'  },
  { id: 'process',      label: 'Process'       },
  { id: 'benefits',     label: 'Benefits'      },
  { id: 'restrictions', label: 'Restrictions'  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Marriage Visa Chiang Mai',
  description: 'Thai marriage visa (Non-Immigrant O) for spouses of Thai nationals. Annual extensions, financial evidence, and 90-day reports are handled end to end by Vera Visa in Chiang Mai.',
  provider: { '@type': 'LocalBusiness', name: 'Vera Visa Agency', url: 'https://vera-visa.com' },
  areaServed: { '@type': 'Country', name: 'Thailand' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What are the financial requirements for the marriage visa in Thailand?', acceptedAnswer: { '@type': 'Answer', text: 'You need either 400,000 THB in a Thai bank account, a monthly income of 40,000 THB transferred from abroad, or a combination of savings and income totalling 400,000 THB. The bank deposit must be held for a set period before your application.' } },
    { '@type': 'Question', name: 'Do you need to be legally married for the Thai marriage visa?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. You must be legally married to a Thai national, registered under Thai law. The marriage must be recorded at a district office (amphoe) in Thailand or your marriage certificate must be legalised and translated if married abroad.' } },
    { '@type': 'Question', name: 'Can I work in Thailand on a marriage visa?', acceptedAnswer: { '@type': 'Answer', text: 'Not automatically. The marriage visa (Non-Immigrant O) does not include work authorisation. To work legally in Thailand you need a separate work permit, which requires employer sponsorship.' } },
    { '@type': 'Question', name: 'How long is the marriage visa in Thailand?', acceptedAnswer: { '@type': 'Answer', text: 'The marriage visa is extended annually at your local immigration office. There is no fixed end date: as long as your marriage is valid and you meet the financial requirements, you can renew indefinitely.' } },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: 'Marriage Visa Chiang Mai', item: 'https://vera-visa.com/marriage-visa-chiang-mai/' },
  ],
};
---

<ServicePageLayout
  title="Marriage Visa Chiang Mai: Requirements | Vera Visa"
  description="Married to a Thai national? The marriage visa lets you live in Chiang Mai year-round. Vera Visa handles the application and annual renewals end to end."
  canonicalUrl="https://vera-visa.com/marriage-visa-chiang-mai/"
  ogTitle="Marriage Visa Chiang Mai 2026: Requirements & Full Guide | Vera Visa"
  ogDescription="Spouse of a Thai national? Live in Chiang Mai year-round on the Non-Immigrant O marriage visa. Annual renewals handled by Vera Visa."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
  eyebrow="Non-Imm O · Marriage"
  intro="Live where your family is, legally and long-term. The marriage visa lets spouses of Thai nationals live in Chiang Mai year-round. Our team renews it each year, with 90-day reports handled as standard."
  ctaText="Check your eligibility on WhatsApp →"
  statusRows={[
    { label: 'Visa Type',    value: 'Non-Imm O'   },
    { label: 'Basis',        value: 'Marriage'     },
    { label: 'Stay',         value: '1 year'       },
  ]}
  statusState="approved"
  statusLabel="Approved"
>
  <Fragment slot="headline">
    Marriage Visa <span style="color: var(--signal);">Chiang Mai</span>: Requirements &amp; Application
  </Fragment>

  <QuickFactsStrip facts={[
    { label: 'Visa Type',      value: 'Non-Imm O'           },
    { label: 'Duration',       value: '1 year (renewable)'  },
    { label: 'Bank Deposit',   value: '400,000 THB'         },
    { label: 'Monthly Income', value: '40,000 THB'          },
    { label: 'Basis',          value: 'Legal marriage'      },
    { label: 'Work Allowed',   value: 'Permit required'     },
    { label: '90-Day Report',  value: 'Required'            },
  ]} />

  <BenefitGrid
    eyebrow="Marriage Visa Benefits"
    heading="Legal long-term stay with your Thai spouse"
    intro="The Non-Immigrant O marriage visa is the most straightforward long-stay option for spouses of Thai nationals."
    items={[
      { title: 'Year-round legal residence', body: 'Live with your spouse in Chiang Mai without tourist visa limitations or border runs.' },
      { title: 'Lower financial threshold',  body: '400,000 THB in a Thai bank or 40,000 THB/month income, lower requirements than the retirement visa.' },
      { title: 'Renewable indefinitely',     body: 'Annual renewals with no end date, as long as your marriage is intact and you meet the financial threshold.' },
      { title: 'Work permit eligible',       body: 'The O visa is the correct visa type to then obtain a Thai work permit if you find local employment.' },
      { title: 'Travel flexibility',         body: 'A re-entry permit lets you leave and return to Thailand without losing your visa status.' },
      { title: 'Family stability',           body: 'Settling your long-term legal status removes uncertainty from the relationship and enables proper life planning in Thailand.' },
    ]}
  />

  <section class="section" style="background: var(--paper); padding-bottom: var(--space-5);">
    <div class="container">
      <h2 class="panel-h2">Learn More About the Marriage Visa</h2>
      <p class="panel-intro">Eligibility, documents, the application process, and what you can and can't do on the Non-Immigrant O.</p>
    </div>
  </section>

  <TabBar client:load tabs={TABS} defaultTab="eligibility" />

  <div style="background: var(--paper); padding: var(--space-7) 0 var(--space-9);">
    <div class="container">

      <section data-tab-panel="eligibility">
        <h2 class="panel-h2">Who qualifies for the marriage visa</h2>
        <p class="panel-intro">Two requirements: a legal marriage to a Thai national, and meeting the financial threshold.</p>

        <AccordionSection client:visible title="Legal Marriage to a Thai National" defaultOpen={true}>
          <p>Two things qualify you for this visa: your marriage is legally registered, and you meet the financial threshold below. That's it. Immigration is checking paperwork, not judging your relationship.</p>
          <p>Your marriage must be registered at a district office (amphoe) in Thailand, or if married abroad, your marriage certificate must be legalised and translated into Thai. Common law relationships and long-term partnerships without legal registration don't qualify for this specific visa category, but a legally registered marriage of any length does. See our <a href="/marriage-visa-thailand/" class="vv-link">Thailand marriage visa</a> guide for the broader overview of requirements and what happens if a marriage ends.</p>
        </AccordionSection>

        <AccordionSection client:visible title="Financial Requirements">
          <p>You must meet <strong>one</strong> of these three financial routes:</p>
          <FinancialRoutes routes={[
            { label: 'Bank Deposit Route', value: '400,000 THB', desc: 'Held in a Thai bank for the required period before and after your application.' },
            { label: 'Monthly Income Route', value: '40,000 THB', unit: '/month', desc: 'Transferred to a Thai account from abroad on a regular basis.' },
            { label: 'Combination Route', value: 'Income + savings = 400,000 THB', desc: 'Example: 20,000 THB/month income (240,000 THB/year) plus 160,000 THB in savings.' },
          ]} />
          <p>The deposit timing is strictly enforced, so we advise every client on the correct schedule before they fund the account.</p>
        </AccordionSection>

        <AccordionSection client:visible title="Applying From Inside Thailand">
          <p>If you are already in Thailand on a tourist visa or exemption, you can apply for the Non-Immigrant O at Chiang Mai immigration. This is the most common route for our clients who are already living with their spouse here.</p>
        </AccordionSection>

        <AccordionSection client:visible title="Same-Sex Marriage and the Thai Marriage Visa">
          <p>As of <strong>22 January 2025</strong>, Thailand's Marriage Equality Act grants same-sex couples full marriage equality, making Thailand the first country in Southeast Asia to do so. Same-sex couples where at least one partner is a Thai national can register their marriage at a district office (amphoe) on the same basis as any other couple.</p>
          <p>The marriage certificate issued (a Kor Ror 3) is the same document regardless of the couple's gender, and is accepted by Thai immigration on the same terms. Same-sex married couples therefore qualify for the Non-Immigrant O marriage visa on identical grounds, with the same financial thresholds and documentation requirements.</p>
        </AccordionSection>

        <ExpertInsightCallout body="Bank deposit timing is the most common reason marriage visa applications are delayed or rejected. The 400,000 THB must be in the account for a set number of days before you apply. We advise every client on the exact schedule." />
      </section>

      <section data-tab-panel="requirements" hidden>
        <h2 class="panel-h2">Documents you'll need</h2>
        <p class="panel-intro">Both you and your Thai spouse provide documentation. We prepare and check everything before submission.</p>

        <AccordionSection client:visible title="Your Documents" defaultOpen={true}>
          <ul>
            <li>Passport valid for at least 18 months with blank visa pages</li>
            <li>Recent passport-style photographs</li>
            <li>Completed Non-Immigrant O application form</li>
            <li>Proof of current visa or entry stamp</li>
            <li>Thai bank book and bank letter confirming the 400,000 THB deposit (or income evidence)</li>
          </ul>
        </AccordionSection>

        <AccordionSection client:visible title="Marriage Documentation">
          <ul>
            <li>Official Thai marriage certificate (Kor Ror 3) from the district office</li>
            <li>If married abroad: original marriage certificate, legalised with apostille and translated into Thai by a certified translator</li>
          </ul>
        </AccordionSection>

        <AccordionSection client:visible title="Thai Spouse Documents">
          <ul>
            <li>Thai national ID card (front and back)</li>
            <li>Thai household registration book (tabien baan), ideally showing the shared address</li>
            <li>Spouse's house registration certificate</li>
          </ul>
        </AccordionSection>

        <AccordionSection client:visible title="Address Documentation">
          <ul>
            <li>Proof of your address in Chiang Mai: lease agreement or TM30 house registration</li>
            <li>Your landlord must file a <a href="/thailand-tm30-reporting-guide/">TM30</a> with immigration when you move in (we handle this reminder)</li>
          </ul>
        </AccordionSection>

        <ExpertInsightCallout body="Foreign marriage certificates need legalisation and certified Thai translation, a process that takes 2–4 weeks. We flag this at the start so it doesn't delay your application at the end." />
        <p class="panel-intro" style="margin-top: var(--space-4);">See our <a href="/marriage-visa-thailand-requirements/" class="vv-link">marriage visa requirements in Thailand</a> guide for the full document-by-document checklist, including renewal documents and common mistakes to avoid.</p>
      </section>

      <section data-tab-panel="process" hidden>
        <ProcessComparisonCards
          heading="How to apply"
          intro="Most clients apply in-country at Chiang Mai immigration. Embassy applications are also available."
          routeA={{
            label: 'Route A',
            title: 'In-Country at Chiang Mai Immigration',
            steps: [
              'Open a Thai bank account and deposit 400,000 THB (or prepare income evidence)',
              'Gather all documents including marriage certificate and spouse ID',
              'Submit at Chiang Mai immigration for Non-Immigrant O',
              'Renew annually: we handle the full process each year',
            ],
          }}
          routeB={{
            label: 'Route B',
            title: 'At a Thai Embassy Abroad',
            steps: [
              'Prepare all documents including legalised marriage certificate',
              'Apply for the Non-Immigrant O at a Thai embassy in your country',
              'Enter Thailand and register your address with immigration',
              'Extend annually at Chiang Mai immigration',
            ],
          }}
          stats={[
            { label: 'Processing Time', value: '1–3 days', note: 'in-country' },
            { label: 'Annual Renewal Fee', value: '1,900 THB' },
          ]}
        />
      </section>

      <section data-tab-panel="benefits" hidden>
        <h2 class="panel-h2">Why the Non-Immigrant O for married couples</h2>
        <BenefitsSplit
          items={[
            'Lower financial threshold than the retirement visa (400k vs 800k THB)',
            'Renewable indefinitely, with no time limit on how long you can stay',
            'Correct visa type for obtaining a Thai work permit',
            'Travel freely with a re-entry permit',
            '90-day reports handled by our team as standard',
          ]}
          statLabel="Annual Renewal Fee"
          statValue="1,900 THB"
          statDesc="Official immigration fee. Chat with us for a full breakdown including our service fee."
        />
      </section>

      <section data-tab-panel="restrictions" hidden>
        <h2 class="panel-h2">What you can &amp; can't do</h2>

        <AccordionSection client:visible title="Can you work in Thailand?" defaultOpen={true}>
          <p>Not without a work permit. The Non-Immigrant O marriage visa gives you the right to live in Thailand, but not to work. To work legally you need a work permit issued by the Department of Employment, which typically requires employer sponsorship. We can refer you to the right contacts if you need a work permit.</p>
        </AccordionSection>

        <AccordionSection client:visible title="Do you need 90-day reports?">
          <p>Yes. If you stay in Thailand for more than 90 consecutive days without exiting, you must file a 90-day report. We handle this for all ongoing clients.</p>
        </AccordionSection>

        <AccordionSection client:visible title="Can you leave Thailand?">
          <p>Yes, but you need a re-entry permit before you exit: either a single (1,000 THB) or multiple (3,800 THB) re-entry permit. Leaving without one cancels your visa and you must apply again from scratch.</p>
        </AccordionSection>

        <AccordionSection client:visible title="What if the marriage ends?">
          <p>This is a hard question to face, and we handle it with the same care we'd want for our own family. If your marriage to a Thai national ends (through divorce or the death of your spouse), you're no longer eligible for the marriage visa on that basis, but you do have other options.</p>
          <p>Contact us as early as you're able to. We'll talk through what applies to your situation (often a guardian visa if you have children in school here, or another visa category) and plan the transition with you, not just at you.</p>
        </AccordionSection>

        <CtaCallout
          kicker="Ready to get started?"
          body="A free WhatsApp consultation confirms your financial route and what documents you need to prepare."
          linkText="Chat with us now"
          linkHref="https://wa.me/66908917582"
        />
      </section>

    </div>
  </div>

  <RelatedGuides guides={[
    { label: 'Marriage Visa Thailand', href: '/category/marriage-visa/' },
    { label: 'Guardian Visa (O)',              href: '/guardian-visa-chiang-mai/'   },
    { label: 'Retirement Visa (O-A)',          href: '/retirement-visa-chiang-mai/' },
    { label: 'DTV Visa (for remote workers)',  href: '/dtv-visa-chiang-mai/'        },
    { label: 'Business Visa & Work Permits',   href: '/work-permits-business-visas-chiang-mai/'   },
    { label: 'Marriage Visa Thailand Cost',    href: '/marriage-visa-thailand-cost/' },
    { label: 'TM30 Reporting: Full Guide',     href: '/thailand-tm30-reporting-guide/' },
  ]} />

  <FinalCtaBand
    heading="Ready to settle in Chiang Mai with your family?"
    subtext="A free consultation confirms your eligibility and gets your marriage visa process started."
  />

  <style>
    .panel-h2 { font-family: var(--font-display); font-weight: 600; font-size: var(--text-display-m); line-height: var(--lh-snug); letter-spacing: var(--ls-display); color: var(--ink); margin: 0 0 var(--space-2); }
    .panel-intro { font-family: var(--font-body); font-size: 1.0625rem; line-height: var(--lh-body); color: var(--text-body); margin: 0 0 var(--space-6); max-width: 64ch; }
  </style>
</ServicePageLayout>
