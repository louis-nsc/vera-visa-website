---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'cheapest-ed-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  heroImage="/images/guides/guide-cost-breakdown"
  heroAlt="Calculator, ledger and pen on a desk, comparing the cheapest ED visa options in Thailand"
  {title} {description}
  canonicalUrl="https://vera-visa.com/cheapest-ed-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Thai Language School ED Visa', href: '/thai-language-school-ed-visa-chiang-mai/' },
    { label: 'Muay Thai ED Visa',             href: '/muay-thai-ed-visa-thailand/'              },
    { label: 'More Education Visa Guides',    href: '/category/education-visa/'                 },
  ]}
>
  <Content />
</BlogLayout>
