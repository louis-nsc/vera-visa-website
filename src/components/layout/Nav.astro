---
const WA_HREF = 'https://wa.me/66908917582';

const services = [
  { label: 'Visa Agent Chiang Mai', href: '/visa-agent-chiang-mai/' },
  { label: 'DTV Visa',              href: '/dtv-visa-chiang-mai/' },
  { label: 'Education Visa',        href: '/education-visa-chiang-mai/' },
  { label: 'Volunteer Visa',        href: '/volunteer-visa-chiang-mai/' },
  { label: 'Marriage Visa',         href: '/marriage-visa-chiang-mai/' },
  { label: 'Guardian Visa',         href: '/guardian-visa-chiang-mai/' },
  { label: 'Business / Work Permit',href: '/work-permits-business-visas-chiang-mai/' },
  { label: 'Retirement Visa',       href: '/retirement-visa-chiang-mai/' },
];
---

<nav class="nav" aria-label="Main navigation">
  <div class="container nav__inner">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Vera Visa homepage">
      <img src="/vera-logo-badge.png" alt="" width="40" height="40" />
      <span class="nav__logo-name">Vera Visa</span>
    </a>

    <!-- Desktop links -->
    <div class="nav__links">
      <!-- Services dropdown -->
      <div class="nav__dropdown">
        <button class="nav__dropdown-trigger" aria-expanded="false">
          Visa Services
          <span class="nav__caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav__dropdown-menu">
          {services.map((s) => (
            <a href={s.href} class="nav__dropdown-item">{s.label}</a>
          ))}
        </div>
      </div>

      <a href="/about/" class="nav__link">About</a>
      <a href="/contact/" class="nav__link">Contact</a>

      <!-- WhatsApp CTA -->
      <a href={WA_HREF} class="nav__cta vv-cta" target="_blank" rel="noopener noreferrer">
        <svg class="nav__wa-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
        </svg>
        Free Consultation
      </a>
    </div>

    <!-- Mobile burger -->
    <button class="nav__burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile-menu">
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
    </button>
  </div>

  <!-- Mobile menu drawer -->
  <div class="nav__mobile-menu" id="nav-mobile-menu" hidden>
    <a href="/about/" class="nav__mobile-link">About</a>
    <a href="/contact/" class="nav__mobile-link">Contact</a>
    <p class="nav__mobile-heading">Visa Services</p>
    {services.map((s) => (
      <a href={s.href} class="nav__mobile-link nav__mobile-link--sub">{s.label}</a>
    ))}
    <a href={WA_HREF} class="nav__mobile-cta vv-cta" target="_blank" rel="noopener noreferrer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
      </svg>
      Free Consultation
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo img {
    width: 40px;
    height: 40px;
  }

  .nav__logo-name {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: 1.25rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__link {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-m);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .nav__link:hover {
    color: var(--signal-deeper);
  }

  /* Dropdown */
  .nav__dropdown {
    position: relative;
  }

  /* Invisible hover bridge: without this, the 12px gap between the trigger
     and .nav__dropdown-menu below is outside every element's hoverable box,
     so :hover ends the instant the pointer crosses it, closing the menu
     before the user can reach an item. This pseudo-element is a descendant
     of .nav__dropdown, so hovering it keeps .nav__dropdown:hover true across
     the gap. */
  .nav__dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 260px;
    height: 12px;
  }

  .nav__dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-m);
    color: var(--ink);
    padding: 0;
    transition: color var(--dur-fast) ease;
  }

  .nav__dropdown-trigger:hover {
    color: var(--signal-deeper);
  }

  .nav__caret {
    font-size: 12px;
    color: var(--ink-45);
    display: inline-block;
    transition: transform var(--dur-fast) ease;
  }

  .nav__dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    width: 260px;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-2);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }

  /* Open on hover (desktop) */
  .nav__dropdown:hover .nav__dropdown-menu,
  .nav__dropdown:focus-within .nav__dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav__dropdown:hover .nav__caret,
  .nav__dropdown:focus-within .nav__caret {
    transform: rotate(180deg);
  }

  .nav__dropdown-item {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    font-size: var(--text-body-m);
    font-family: var(--font-body);
    transition: background var(--dur-fast) ease;
  }

  .nav__dropdown-item:hover {
    background: var(--sand);
  }

  /* CTA button */
  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-5);
    background: var(--signal-deep);
    color: var(--paper);
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-s);
    text-decoration: none;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .nav__cta:hover {
    background: var(--signal-deeper);
  }

  .nav__wa-icon {
    flex-shrink: 0;
  }

  /* Mobile burger button */
  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav__burger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    transition: transform var(--dur-fast) var(--ease-standard),
                opacity var(--dur-fast) var(--ease-standard);
  }

  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(2) {
    opacity: 0;
  }

  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile drawer */
  .nav__mobile-menu {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border-top: var(--border);
    padding: var(--space-4) var(--container-pad) var(--space-6);
    max-height: calc(100vh - 72px);
    overflow-y: auto;
  }

  .nav__mobile-menu[hidden] {
    display: none;
  }

  .nav__mobile-link {
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-m);
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .nav__mobile-link--sub {
    padding-left: var(--space-3);
    font-weight: var(--fw-regular);
    color: var(--text-body);
  }

  .nav__mobile-heading {
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label-wide);
    text-transform: uppercase;
    color: var(--ink-45);
    margin: var(--space-4) 0 0;
  }

  .nav__mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: 14px var(--space-5);
    background: var(--signal-deep);
    color: var(--paper);
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--text-body-m);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .nav__mobile-cta:hover {
    background: var(--signal-deeper);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }
  }

  @media (min-width: 901px) {
    .nav__mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  // Mobile burger toggle
  const burger = document.querySelector('.nav__burger');
  const mobileMenu = document.querySelector('.nav__mobile-menu');

  function closeMobileMenu() {
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open menu');
    mobileMenu.setAttribute('hidden', '');
  }

  if (burger && mobileMenu) {
    burger.addEventListener('click', () => {
      const isOpen = burger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMobileMenu();
      } else {
        burger.setAttribute('aria-expanded', 'true');
        burger.setAttribute('aria-label', 'Close menu');
        mobileMenu.removeAttribute('hidden');
      }
    });

    // Close the drawer if the viewport grows back to desktop width
    const desktopQuery = window.matchMedia('(min-width: 901px)');
    desktopQuery.addEventListener('change', (e) => {
      if (e.matches) closeMobileMenu();
    });
  }

  // Desktop dropdown: keep aria-expanded truthful for assistive tech
  const dropdown = document.querySelector('.nav__dropdown');
  const dropdownTrigger = document.querySelector('.nav__dropdown-trigger');

  if (dropdown && dropdownTrigger) {
    const setOpen = (open) => dropdownTrigger.setAttribute('aria-expanded', String(open));

    dropdown.addEventListener('mouseenter', () => setOpen(true));
    dropdown.addEventListener('mouseleave', () => setOpen(false));
    dropdown.addEventListener('focusin', () => setOpen(true));
    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget)) setOpen(false);
    });
  }

  // Escape closes whichever disclosure is open. For the desktop dropdown
  // (driven purely by :hover/:focus-within, no JS open/closed state) the
  // only way to close it is to remove focus from its descendants; this
  // moves focus to the document rather than back to the trigger, which is
  // an accepted tradeoff for this simple hover-disclosure pattern. For the
  // mobile drawer, focus returns to the burger button that opened it.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;

    if (dropdown && dropdown.contains(document.activeElement)) {
      document.activeElement.blur();
    }

    if (mobileMenu && !mobileMenu.hasAttribute('hidden')) {
      closeMobileMenu();
      burger.focus();
    }
  });
</script>
