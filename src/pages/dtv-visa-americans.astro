---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'dtv-visa-americans');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  heroImage="/images/guides/guide-arrival-dtv"
  heroAlt="Laptop bag and passport on a bed beside an open suitcase in a bright guesthouse room, planning a Thailand DTV visa"
  {title} {description}
  canonicalUrl="https://vera-visa.com/dtv-visa-americans/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'DTV Visa Thailand', href: '/category/dtv-visa/' },
    { label: 'Thailand Visa for Americans: All Options', href: '/thailand-visa-for-americans/'  },
    { label: 'DTV Visa Chiang Mai: Full Guide',         href: '/dtv-visa-chiang-mai/'          },
    { label: 'Retirement Visa for Americans',            href: '/retirement-visa-americans/'    },
    { label: 'Retirement Visa Chiang Mai',               href: '/retirement-visa-chiang-mai/'   },
    { label: 'Visa Agent Chiang Mai',                    href: '/visa-agent-chiang-mai/'        },
  ]}
>
  <Content />
</BlogLayout>
