---
import BaseLayout from '../layouts/BaseLayout.astro';

const LAST_UPDATED = 'July 2026';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: 'https://vera-visa.com/privacy-policy/' },
  ],
};
---

<BaseLayout
  title="Privacy Policy | Vera Visa"
  description="How Vera Visa Agency collects, uses, and protects your personal data: contact form enquiries, analytics, and your rights under Thailand's PDPA."
  canonicalUrl="https://vera-visa.com/privacy-policy/"
  schema={schema}
>
  <nav class="legal-breadcrumb container" aria-label="Breadcrumb">
    <a href="/" class="bc-link">Home</a>
    <span class="bc-sep" aria-hidden="true">›</span>
    <span class="bc-current">Privacy Policy</span>
  </nav>

  <header class="legal-header">
    <div class="container legal-header__inner">
      <p class="legal-eyebrow">Vera Visa Agency</p>
      <h1 class="legal-h1">Privacy Policy</h1>
      <p class="legal-updated">Last updated: {LAST_UPDATED}</p>
    </div>
  </header>

  <div class="legal-body container">
    <div class="legal-prose">
      <p>
        Vera Visa Agency ("Vera Visa", "we", "us") operates vera-visa.com and provides
        visa consulting services in Chiang Mai, Thailand. This policy explains what
        personal data we collect through this website, why, and what rights you have
        over it.
      </p>

      <h2>What we collect</h2>
      <p>
        <strong>Contact form.</strong> If you use the contact form on this site, we
        collect your name, email address, and the message you send. That's the entire
        set of fields. We don't ask for anything else through the form.
      </p>
      <p>
        <strong>WhatsApp.</strong> Our primary contact channel is WhatsApp. Conversations
        there happen on Meta's platform and are governed by
        <a href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">WhatsApp's own privacy policy</a>,
        not this one. We don't control how WhatsApp itself handles that data.
      </p>
      <p>
        <strong>Analytics.</strong> We use Google Analytics and WhatConverts to
        understand how visitors use this site: pages viewed, approximate location,
        device/browser type, and referral source. These tools use cookies. We use
        Google Search Console to monitor the site's presence in Google Search results;
        it does not collect data about individual visitors.
      </p>

      <h2>How we use it</h2>
      <ul>
        <li>Respond to your enquiry and, if you engage us, provide visa consulting services</li>
        <li>Understand which pages and content are actually useful, so we can improve them</li>
        <li>Meet our own legal and accounting obligations as a business operating in Thailand</li>
      </ul>
      <p>
        We do not sell your personal data, and we do not use your enquiry to send
        unsolicited marketing.
      </p>

      <h2>Who we share it with</h2>
      <p>
        Contact form submissions are delivered via <strong>Resend</strong>, our
        transactional email provider, directly to our team's inboxes. We don't store
        submissions in a separate database. Analytics data is processed by
        <strong>Google</strong> and <strong>WhatConverts</strong> under their own
        respective privacy policies. None of these providers are permitted to use your
        data for their own purposes beyond providing the service to us.
      </p>
      <p>
        Because these providers operate infrastructure outside Thailand, your data may
        be processed or stored on servers in other countries (including the United
        States) as part of that relationship.
      </p>

      <h2>How long we keep it</h2>
      <p>
        We keep enquiry emails for as long as reasonably needed to respond to you and,
        if you become a client, to provide our services and meet our own record-keeping
        obligations. We don't keep an indefinite marketing list. If you'd like us to
        delete a past enquiry, just ask (see Contact below).
      </p>

      <h2>Your rights</h2>
      <p>
        As a Thailand-based business, we handle personal data in line with Thailand's
        <strong>Personal Data Protection Act (PDPA)</strong>. If you're contacting us
        from the UK, EU, Australia, Canada, or elsewhere, we also aim to honour the
        spirit of your home jurisdiction's data protection rights where they'd apply.
        In practice, this means you can ask us at any time to:
      </p>
      <ul>
        <li>Tell you what personal data we hold about you</li>
        <li>Correct inaccurate data</li>
        <li>Delete data we no longer need to hold</li>
        <li>Stop using your data for a particular purpose</li>
      </ul>
      <p>
        To exercise any of these, email <a href="mailto:pupae@vera-visa.com">pupae@vera-visa.com</a>.
        We'll respond within a reasonable time.
      </p>

      <h2>Cookies</h2>
      <p>
        This site uses cookies set by Google Analytics and WhatConverts to measure site
        usage, as described above. You can block or delete cookies through your
        browser's settings at any time; doing so won't affect your ability to browse
        the site or contact us.
      </p>

      <h2>Children</h2>
      <p>
        This site and our services are directed at adults arranging their own or their
        family's visa status. We don't knowingly collect personal data directly from
        children.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        We may update this policy as our tools or practices change. The "last updated"
        date at the top of this page reflects the most recent revision.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy or your data: <a href="mailto:pupae@vera-visa.com">pupae@vera-visa.com</a>,
        or visit us at 2F, Room 215 Icon Park Hotel, 310 Manee Nopparat Rd, Mueang
        Chiang Mai District, Chiang Mai 50200.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .bc-link { color: var(--ink-45); text-decoration: none; transition: color var(--dur-fast) ease; }
  .bc-link:hover { color: var(--signal-deeper); }
  .bc-sep { color: var(--line); }
  .bc-current { color: var(--ink-45); }

  .legal-header {
    background: var(--sand);
    padding: var(--space-7) 0 var(--space-8);
  }

  .legal-header__inner { max-width: 760px; }

  .legal-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin: 0 0 var(--space-4);
  }

  .legal-h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2rem, 4vw, var(--text-display-l));
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .legal-updated {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
    margin: 0;
  }

  .legal-body {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .legal-prose { max-width: 720px; }

  .legal-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-s);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: var(--space-7) 0 var(--space-3);
  }

  .legal-prose :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
  }

  .legal-prose :global(ul) {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  .legal-prose :global(li) { margin-bottom: var(--space-2); }
  .legal-prose :global(strong) { color: var(--ink); font-weight: var(--fw-semibold); }
  .legal-prose :global(a) { color: var(--signal-deeper); text-decoration: underline; text-underline-offset: 2px; }
</style>
