---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'retire-in-thailand-from-australia');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/retire-in-thailand-from-australia/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa for Australians', href: '/retirement-visa-australians/'   },
    { label: 'Retirement Visa Chiang Mai',      href: '/retirement-visa-chiang-mai/'    },
    { label: 'More Guides',                     href: '/category/uncategorized/'        },
  ]}
>
  <Content />
</BlogLayout>
