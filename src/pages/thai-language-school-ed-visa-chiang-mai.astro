---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thai-language-school-ed-visa-chiang-mai');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/thai-language-school-ed-visa-chiang-mai/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Education Visa Chiang Mai: Full Guide', href: '/education-visa-chiang-mai/'        },
    { label: 'ED Visa Language Schools',                href: '/ed-visa-language-schools-chiang-mai/' },
    { label: 'Cheapest ED Visa Options',                href: '/cheapest-ed-visa-thailand/'           },
  ]}
>
  <Content />
</BlogLayout>
