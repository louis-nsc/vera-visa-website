---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'muay-thai-ed-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  heroImage="/images/guides/guide-muay-thai-gloves"
  heroAlt="Dark boxing gloves with an orange wrap hanging in a bright gym, training Muay Thai on an ED visa"
  {title} {description}
  canonicalUrl="https://vera-visa.com/muay-thai-ed-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Education Visa Thailand', href: '/category/education-visa/' },
    { label: 'Education Visa Chiang Mai: Full Guide', href: '/education-visa-chiang-mai/'    },
    { label: 'DTV Visa Chiang Mai',                     href: '/dtv-visa-chiang-mai/'         },
    { label: 'Cheapest ED Visa Options',                href: '/cheapest-ed-visa-thailand/'   },
  ]}
>
  <Content />
</BlogLayout>
