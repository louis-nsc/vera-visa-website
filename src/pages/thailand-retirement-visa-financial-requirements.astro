---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thailand-retirement-visa-financial-requirements');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/thailand-retirement-visa-financial-requirements/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Thailand', href: '/category/retirement-visa/' },
    { label: 'Retirement Visa Chiang Mai: Full Guide', href: '/retirement-visa-chiang-mai/'        },
    { label: 'Retirement Visa Thailand Requirements',   href: '/retirement-visa-thailand-requirements/' },
    { label: 'Retirement Visa Thailand Cost',           href: '/retirement-visa-thailand-cost/'      },
  ]}
>
  <Content />
</BlogLayout>
