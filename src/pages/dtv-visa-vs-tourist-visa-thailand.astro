---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'dtv-visa-vs-tourist-visa-thailand');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/dtv-visa-vs-tourist-visa-thailand/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'DTV Visa Chiang Mai: Full Guide', href: '/dtv-visa-chiang-mai/'    },
    { label: 'DTV Visa Thailand Cost',           href: '/dtv-visa-thailand-cost/' },
    { label: 'DTV Visa Thailand Requirements',   href: '/dtv-visa-thailand-requirements/' },
  ]}
>
  <Content />
</BlogLayout>
