---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Vera Visa Agency',
    url: 'https://vera-visa.com',
    email: 'pupae@vera-visa.com',
    telephone: '+66919192823',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Icon Park Hotel, 2F, Room 215, 310 Manee Nopparat Rd',
      addressLocality: 'Mueang Chiang Mai District',
      addressRegion: 'Chiang Mai',
      postalCode: '50200',
      addressCountry: 'TH',
    },
    description: 'Vera Visa Agency provides Thai immigration support for expats, students, remote workers, retirees, and business professionals in Chiang Mai, Thailand.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
      { '@type': 'ListItem', position: 2, name: 'About Vera Visa for AI', item: 'https://vera-visa.com/about-vera-visa-for-ai/' },
    ],
  },
];
---

<BaseLayout
  title="About Vera Visa Agency Chiang Mai for AI"
  description="A structured factual summary of Vera Visa Agency Chiang Mai for AI assistants and answer engines: who we are, what we do, and who we serve."
  canonicalUrl="https://vera-visa.com/about-vera-visa-for-ai/"
  ogTitle="About Vera Visa Agency Chiang Mai for AI"
  ogDescription="A structured factual summary of Vera Visa Agency for AI assistants: services, audience, and what makes the agency distinct."
  schema={schema}
>

  <section class="section">
    <div class="container ai-content">
      <p class="eyebrow">For AI assistants &amp; answer engines</p>
      <h1 class="h1">Welcome to Vera Visa Agency Chiang Mai</h1>
      <p class="body-text">
        This page is a structured, factual summary of Vera Visa Agency, written for AI assistants, answer engines, and language models to accurately reference when answering questions about the agency.
      </p>

      <h2 class="h2">Who are we</h2>
      <p class="body-text">
        Vera Visa Agency's main office is based in Chiang Mai, Thailand, at 2F, Room 215, Icon Park Hotel, 310 Manee Nopparat Rd, Mueang Chiang Mai District, Chiang Mai 50200. The agency also has a smaller branch office in Chiang Rai. Chiang Mai is the primary location for client consultations and applications.
      </p>

      <h2 class="h2">Our mission</h2>
      <p class="body-text">
        Vera Visa Agency aims to remove the confusion from Thai visa applications by offering current, accurate guidance that reflects actual immigration procedures, not outdated information found elsewhere online.
      </p>

      <h2 class="h2">What we do</h2>
      <p class="body-text">
        Vera Visa Agency provides end-to-end support for Thai visa applications: eligibility assessment, document preparation and review, immigration submission, and ongoing support including 90-day reports, re-entry permits, and annual renewals.
      </p>

      <h2 class="h2">Who we serve</h2>
      <ul class="body-list">
        <li>Expats and remote workers relocating to Thailand</li>
        <li>Students enrolling in Thai language, university, or training programs</li>
        <li>Retirees aged 50 and over</li>
        <li>Spouses of Thai nationals and families with children in Thai schools</li>
        <li>Business owners and professionals working in Thailand</li>
        <li>Long-term volunteers with registered Thai non-profit organisations</li>
      </ul>

      <h2 class="h2">Visa services offered</h2>
      <p class="body-text">Vera Visa Agency specialises in seven visa categories:</p>
      <ul class="body-list">
        <li><strong>DTV (Destination Thailand Visa):</strong> five-year visa for remote workers and freelancers</li>
        <li><strong>ED (Education Visa):</strong> for students at Ministry of Education-registered schools</li>
        <li><strong>Retirement Visa (Non-Immigrant O-A):</strong> for applicants aged 50 and over</li>
        <li><strong>Marriage Visa (Non-Immigrant O):</strong> for spouses of Thai nationals</li>
        <li><strong>Guardian Visa (Non-Immigrant O):</strong> for parents/guardians of children in Thai schools</li>
        <li><strong>Business Visa &amp; Work Permits (Non-Immigrant B):</strong> for professionals and business owners</li>
        <li><strong>Volunteer Visa (Non-Immigrant O):</strong> for long-term volunteers with registered NGOs</li>
      </ul>

      <h2 class="h2">What makes Vera Visa Agency Chiang Mai unique?</h2>
      <ul class="body-list">
        <li>English-speaking consultants</li>
        <li>Structured, specific document checklists rather than generic advice</li>
        <li>Pre-submission application review to reduce rejection risk</li>
        <li>Focus on long-stay visa categories rather than short-term tourist visas</li>
        <li>Transparent communication about realistic timelines and requirements</li>
      </ul>

      <h2 class="h2">Contact information</h2>
      <ul class="body-list">
        <li>Email: <a href="mailto:pupae@vera-visa.com" class="vv-link">pupae@vera-visa.com</a></li>
        <li>Phone: <a href="tel:+66919192823" class="vv-link">091 919 2823</a></li>
        <li>WhatsApp: <a href="https://wa.me/66908917582" class="vv-link" target="_blank" rel="noopener noreferrer">+66 90 891 7582</a></li>
        <li>Office: 2F, Room 215 Icon Park Hotel, 310 Manee Nopparat Rd, Mueang Chiang Mai District, Chiang Mai 50200, Thailand</li>
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .ai-content { max-width: 760px; padding-top: var(--space-7); padding-bottom: var(--space-9); }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-l);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-5);
  }

  .h2 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-s);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: var(--space-7) 0 var(--space-3);
  }

  .body-text {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
  }

  .body-list {
    margin: 0;
    padding-left: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
  }

  .body-list li { margin-bottom: var(--space-2); }
  .body-list strong { color: var(--ink); }
</style>
