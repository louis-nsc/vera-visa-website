---
import BaseLayout from './BaseLayout.astro';
import RelatedGuides from '../components/sections/RelatedGuides.astro';
import FinalCtaBand from '../components/sections/FinalCtaBand.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  publishedTime: string;
  modifiedTime?: string;
  relatedGuides?: { label: string; href: string }[];
}

const {
  title, description, canonicalUrl, ogTitle, ogDescription, ogImage,
  publishedTime, modifiedTime,
  relatedGuides = [],
} = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ogTitle ?? title,
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime ?? publishedTime,
  author: {
    '@type': 'Organization',
    name: 'Vera Visa Agency',
    url: 'https://vera-visa.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Vera Visa Agency',
    url: 'https://vera-visa.com',
    logo: { '@type': 'ImageObject', url: 'https://vera-visa.com/vera-logo-badge.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
  ],
};

const pubDate = new Date(publishedTime).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const modDate = modifiedTime
  ? new Date(modifiedTime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout
  {title} {description} {canonicalUrl}
  {ogTitle} {ogDescription} {ogImage}
  ogType="article"
  schema={[articleSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav class="blog-breadcrumb container" aria-label="Breadcrumb">
    <a href="/" class="bc-link">Home</a>
    <span class="bc-sep" aria-hidden="true">›</span>
    <span class="bc-current">{title}</span>
  </nav>

  <!-- Article -->
  <article class="blog-article">
    <header class="blog-header">
      <div class="container blog-header__inner">
        <div class="blog-meta">
          <time datetime={publishedTime} class="blog-date">
            {pubDate}
          </time>
          {modDate && modDate !== pubDate && (
            <span class="blog-updated">Updated {modDate}</span>
          )}
        </div>
        <h1 class="blog-h1">{title}</h1>
        <p class="blog-deck">{description}</p>
        <div class="blog-byline">
          <span class="blog-byline-dot" aria-hidden="true"></span>
          <span>By <strong>Vera Visa Agency</strong> · Chiang Mai</span>
        </div>
      </div>
    </header>

    <div class="blog-body container">
      <div class="blog-prose">
        <slot />
      </div>

      <!-- CTA callout mid-article -->
      <aside class="blog-cta-aside">
        <p class="blog-cta-kicker">Free Consultation</p>
        <p class="blog-cta-body">Questions about your specific situation? Chat with Pupae, Tofu, or Big on WhatsApp — usually answered the same day.</p>
        <a href="https://wa.me/66XXXXXXXXX" class="blog-cta-btn vv-cta" target="_blank" rel="noopener noreferrer">
          Chat on WhatsApp →
        </a>
      </aside>
    </div>
  </article>

  {relatedGuides.length > 0 && (
    <RelatedGuides guides={relatedGuides} />
  )}

  <FinalCtaBand
    heading="Ready to get started?"
    subtext="A free consultation confirms the right visa for your situation — usually resolved in one WhatsApp chat."
  />
</BaseLayout>

<style>
  /* Breadcrumb */
  .blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .bc-link {
    color: var(--ink-45);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .bc-link:hover { color: var(--signal-deeper); }
  .bc-sep { color: var(--line); }
  .bc-current { color: var(--ink-45); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 40ch; }

  /* Header */
  .blog-header {
    background: var(--sand);
    padding: var(--space-7) 0 var(--space-8);
  }

  .blog-header__inner { max-width: 760px; }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .blog-date, .blog-updated {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .blog-h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2rem, 4vw, var(--text-display-l));
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }

  .blog-deck {
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }

  .blog-byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-body-s);
    color: var(--ink-45);
  }

  .blog-byline-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--approved);
  }

  /* Body */
  .blog-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* Prose styles */
  .blog-prose { min-width: 0; }

  .blog-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-m);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: var(--space-8) 0 var(--space-4);
  }

  .blog-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-s);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: var(--space-6) 0 var(--space-3);
  }

  .blog-prose :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
    max-width: 68ch;
  }

  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    max-width: 68ch;
  }

  .blog-prose :global(li) { margin-bottom: var(--space-2); }

  .blog-prose :global(strong) { color: var(--ink); font-weight: var(--fw-semibold); }

  .blog-prose :global(a) {
    color: var(--signal-deeper);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-prose :global(a:hover) { color: var(--signal-deeper); }

  .blog-prose :global(blockquote) {
    background: var(--sand);
    border-left: 2px solid var(--signal);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    padding: var(--space-5) var(--space-6);
    margin: var(--space-6) 0;
    font-style: italic;
    color: var(--ink);
    max-width: 68ch;
  }

  .blog-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-family: var(--font-body);
    font-size: var(--text-body-s);
  }

  .blog-prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-45);
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--line);
  }

  .blog-prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    color: var(--text-body);
    vertical-align: top;
  }

  /* CTA aside */
  .blog-cta-aside {
    position: sticky;
    top: calc(72px + var(--space-5));
    background: var(--sand);
    border: var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .blog-cta-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-3);
  }

  .blog-cta-body {
    font-family: var(--font-body);
    font-size: var(--text-body-s);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin-bottom: var(--space-4);
  }

  .blog-cta-btn {
    display: inline-block;
    padding: 10px var(--space-5);
    background: var(--signal-deep);
    color: var(--paper);
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-s);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .blog-cta-btn:hover { background: var(--signal-deeper); }

  /* Responsive */
  @media (max-width: 900px) {
    .blog-body {
      grid-template-columns: 1fr;
    }

    .blog-cta-aside {
      position: static;
      order: -1;
    }
  }
</style>
