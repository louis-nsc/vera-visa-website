---
import BaseLayout from './BaseLayout.astro';

interface StatusRow {
  label: string;
  value: string;
}

interface Props {
  // SEO
  title: string;
  description: string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  schema?: object | object[];

  // Hero text
  eyebrow: string;           // e.g. "DTV · 5-Year Multiple Entry"
  intro: string;             // paragraph below h1
  ctaText?: string;

  // Status card (right side)
  statusRows: StatusRow[];
  statusState?: 'progress' | 'approved';
  statusLabel?: string;
}

const {
  title, description, canonicalUrl, ogTitle, ogDescription, ogImage, schema,
  eyebrow, intro,
  ctaText = 'Check your eligibility on WhatsApp →',
  statusRows,
  statusState = 'approved',
  statusLabel = 'Approved',
} = Astro.props;

const WA_HREF = 'https://wa.me/66XXXXXXXXX';
const dotColor = statusState === 'approved' ? 'var(--approved)' : 'var(--signal)';
---

<BaseLayout
  {title} {description} {canonicalUrl}
  {ogTitle} {ogDescription} {ogImage}
  ogType="website"
  {schema}
>
  <!-- ===== PAGE HEADER ===== -->
  <header class="svc-header">
    <div class="container svc-header__inner">
      <div class="svc-header__text">
        <p class="svc-eyebrow">{eyebrow}</p>
        <h1 class="svc-h1">
          <slot name="headline" />
        </h1>
        <p class="svc-intro">{intro}</p>
        <a href={WA_HREF} class="svc-cta vv-cta" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
          </svg>
          {ctaText}
        </a>
      </div>

      <!-- Status card -->
      <div class="svc-status-card">
        <span class="svc-perf" aria-hidden="true"></span>
        <span class="svc-stamp" aria-hidden="true">Verified</span>
        <div class="svc-status-card__body">
          <p class="svc-status-card__eyebrow">Applicant Status</p>
          <div class="svc-status-rows">
            {statusRows.map((row) => (
              <>
                <span class="svc-status-label">{row.label}</span>
                <span class="svc-status-value">{row.value}</span>
              </>
            ))}
          </div>
          <div class="svc-status-footer">
            <span class="svc-status-label">Status</span>
            <span class="svc-status-badge">
              <span class="svc-status-dot" style={`background: ${dotColor};`}></span>
              <span class="svc-status-badge-label">{statusLabel}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Remaining page sections injected here -->
  <slot />
</BaseLayout>

<style>
  /* ---- Header ---- */
  .svc-header {
    background: var(--paper);
    padding: 64px 0 40px;
  }

  .svc-header__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-8);
    align-items: center;
  }

  /* ---- Hero text ---- */
  .svc-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .svc-h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  .svc-intro {
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin-top: var(--space-5);
    max-width: 48ch;
  }

  .svc-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: 28px;
    padding: 14px var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--signal-deep);
    color: var(--paper);
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--text-body-m);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .svc-cta:hover {
    background: var(--signal-deeper);
  }

  /* ---- Status card ---- */
  .svc-status-card {
    position: relative;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* Perforation dots on left edge */
  .svc-perf {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 16px;
    background-image: radial-gradient(circle, var(--line) 1.6px, transparent 2px);
    background-repeat: repeat-y;
    background-size: 16px 12px;
    background-position: center;
  }

  /* Rotated stamp */
  .svc-stamp {
    position: absolute;
    top: 18px;
    right: 16px;
    transform: rotate(-11deg);
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    padding: 4px 8px;
    box-shadow: inset 0 0 0 1.5px var(--paper), inset 0 0 0 3px var(--ink);
    opacity: 0.55;
  }

  .svc-status-card__body {
    padding: var(--space-5);
    padding-left: 40px;
  }

  .svc-status-card__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .svc-status-rows {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px var(--space-6);
    align-items: baseline;
    border-top: var(--border);
    padding-top: var(--space-4);
  }

  .svc-status-label {
    font-family: var(--font-mono);
    font-size: var(--text-label-s);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label-wide);
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .svc-status-value {
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-align: right;
  }

  .svc-status-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: var(--border);
    padding-top: var(--space-4);
    margin-top: var(--space-4);
  }

  .svc-status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .svc-status-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pill);
  }

  .svc-status-badge-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ---- Responsive ---- */
  @media (max-width: 760px) {
    .svc-header__inner {
      grid-template-columns: 1fr;
    }

    .svc-h1 {
      font-size: 2.5rem;
    }

    .svc-status-card {
      display: none; /* hide status card on mobile — save space */
    }
  }
</style>
