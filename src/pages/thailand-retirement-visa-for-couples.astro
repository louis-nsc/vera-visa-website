---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thailand-retirement-visa-for-couples');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/thailand-retirement-visa-for-couples/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Thailand', href: '/category/retirement-visa/' },
    { label: 'Retirement Visa Chiang Mai: Full Guide',   href: '/retirement-visa-chiang-mai/'        },
    { label: 'Marriage Visa Chiang Mai',                  href: '/marriage-visa-chiang-mai/'          },
    { label: 'Retirement Visa Financial Requirements',    href: '/thailand-retirement-visa-financial-requirements/' },
  ]}
>
  <Content />
</BlogLayout>
