---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewFunnel from '../components/interactive/ReviewFunnel';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vera-visa.com/' },
    { '@type': 'ListItem', position: 2, name: 'Review Vera Visa', item: 'https://vera-visa.com/review-vera-visa/' },
  ],
};
---

<BaseLayout
  title="Review Vera Visa Agency Chiang Mai"
  description="Share your experience with Vera Visa Agency Chiang Mai. Takes less than a minute and helps us serve expats and visa applicants better."
  canonicalUrl="https://vera-visa.com/review-vera-visa/"
  ogTitle="Review Vera Visa Agency Chiang Mai"
  ogDescription="Rate your experience with Vera Visa Agency — takes less than a minute, and helps us improve our service for expats in Chiang Mai."
  schema={schema}
>

  <section class="section">
    <div class="container">
      <div class="review-header">
        <p class="eyebrow">Feedback</p>
        <h1 class="h1">Rate your experience with Vera Visa Agency.</h1>
        <p class="intro">Takes less than 1 minute. Your feedback helps us serve expats and visa applicants better in Chiang Mai.</p>
      </div>

      <ReviewFunnel client:load />
    </div>
  </section>

</BaseLayout>

<style>
  .review-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-8);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(2rem, 4vw, var(--text-display-l));
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }

  .intro {
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
</style>
