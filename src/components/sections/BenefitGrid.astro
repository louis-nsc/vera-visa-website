---
interface BenefitItem {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: BenefitItem[];
}

const { eyebrow, heading, intro, items } = Astro.props;
---

<section class="bg-section section--alt">
  <div class="container">
    {eyebrow && <p class="bg-eyebrow">{eyebrow}</p>}
    <h2 class="bg-heading">{heading}</h2>
    {intro && <p class="bg-intro">{intro}</p>}

    <div class="vv-benefit-grid">
      {items.map((item) => (
        <div class="vv-benefit-cell">
          <h3 class="vv-benefit-title">{item.title}</h3>
          <p class="vv-benefit-body">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bg-section {
    padding: var(--space-8) 0;
  }

  .bg-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--signal-deeper);
    margin-bottom: var(--space-4);
  }

  .bg-heading {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-display-m);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }

  .bg-intro {
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-7);
    max-width: 56ch;
  }
</style>
