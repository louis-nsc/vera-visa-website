---
// Consolidated into guardian-visa-thailand-requirements: this page was a thinner,
// overlapping eligibility overview (its own FAQ even asked "how is this different
// from your other guardian visa pages?") competing with five other guardian-visa
// URLs for the same query, all ranking below position 25. Its unique content (the
// second-parent visa-basis note) has been folded into guardian-visa-thailand-requirements,
// which is the more complete page. Renders that page's content but canonicalizes to
// it, preserving this URL (no 404, no lost backlink equity) while consolidating
// ranking signal onto the stronger page — same pattern as the thailand-e-work-permit
// and thailand-work-permit-foreigners consolidations.
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'guardian-visa-thailand-requirements');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  rawBody={entry.body}
  {title} {description}
  canonicalUrl="https://vera-visa.com/guardian-visa-thailand-requirements/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Guardian Visa Thailand', href: '/category/guardian-visa/' },
    { label: 'Guardian Visa Chiang Mai: Full Guide', href: '/guardian-visa-chiang-mai/' },
    { label: 'Guardian Visa Thailand Cost',           href: '/guardian-visa-thailand-cost/' },
    { label: 'Guardian vs Dependent Visa',            href: '/guardian-visa-vs-dependent-visa-thailand/' },
  ]}
>
  <Content />
</BlogLayout>
