---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'marriage-visa-thailand-cost');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/marriage-visa-thailand-cost/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Marriage Visa Chiang Mai — Full Guide',   href: '/marriage-visa-chiang-mai/'   },
    { label: 'Retirement Visa Chiang Mai',              href: '/retirement-visa-chiang-mai/' },
    { label: 'Guardian Visa Chiang Mai',                href: '/guardian-visa-chiang-mai/'   },
    { label: 'Visa Agent Chiang Mai',                   href: '/visa-agent-chiang-mai/'      },
  ]}
>
  <Content />
</BlogLayout>
