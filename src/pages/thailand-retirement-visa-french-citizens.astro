---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = await getEntry('blog', 'thailand-retirement-visa-french-citizens');
if (!entry) return Astro.redirect('/');
const { Content } = await render(entry);
const { title, description, ogTitle, ogDescription, publishedTime, modifiedTime } = entry.data;
---

<BlogLayout
  {title} {description}
  canonicalUrl="https://vera-visa.com/thailand-retirement-visa-french-citizens/"
  {ogTitle} {ogDescription}
  {publishedTime} {modifiedTime}
  relatedGuides={[
    { label: 'Retirement Visa Thailand', href: '/category/retirement-visa/' },
    { label: 'Retirement Visa Chiang Mai: Full Guide', href: '/retirement-visa-chiang-mai/'    },
    { label: 'Retirement Visa for UK Citizens',         href: '/retirement-visa-uk-citizens/'   },
    { label: 'Retirement Visa Thailand Cost',           href: '/retirement-visa-thailand-cost/' },
  ]}
>
  <Content />
</BlogLayout>
