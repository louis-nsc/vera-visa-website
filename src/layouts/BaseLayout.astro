---
import '../styles/global.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  schema,
  noindex = false,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Bumped by hand whenever a real fact-check pass reviews site content —
// not auto-generated from today's date, which would misleadingly imply
// every page was just re-verified.
const CONTENT_REVIEWED_LABEL = 'July 2026';

const GA_MEASUREMENT_ID = 'G-2J9K5NZ9Q1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Fonts are self-hosted (no third-party render-blocking request); preload the two main latin faces -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="Vera Visa" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/vera-logo-badge.png" />

    <!-- Structured data -->
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google Analytics (GA4) — production only, so local/dev traffic never
         pollutes real analytics data. -->
    {import.meta.env.PROD && (
      <>
        <script define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
          // Load gtag.js after the page has painted so it never competes with the hero image
          function loadGtag() {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
            document.head.appendChild(s);
          }
          window.addEventListener('load', function () {
            if ('requestIdleCallback' in window) requestIdleCallback(loadGtag, { timeout: 3000 });
            else setTimeout(loadGtag, 1500);
          });
        </script>
      </>
    )}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <p class="info-currency">
      Visa rules can change. Accurate as of {CONTENT_REVIEWED_LABEL}, so confirm specifics with our team first.
    </p>
    <Footer />
  </body>
</html>

<style>
  .info-currency {
    margin: 0;
    padding: var(--space-4) var(--container-pad);
    max-width: var(--container-max);
    margin-inline: auto;
    font-family: var(--font-body);
    font-size: var(--text-body-s);
    line-height: var(--lh-body);
    color: var(--ink-45);
    border-top: var(--border);
    /* Always a single line, sitewide, at every viewport — a wrapped or
       multi-line footnote reads as an afterthought, not a deliberate note. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
